{
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && next build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/trial-drip",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/eod-update",
      "schedule": "0 13 * * 1-5"
    },
    {
      "path": "/api/cron/market-observations",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/fii-dii-log",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/fii-dii-log",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/cron/fii-dii-log",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/fii-dii-log",
      "schedule": "30 17 * * *"
    },
    {
      "path": "/api/cron/fii-dii-log?run=morning",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/breadth",
      "schedule": "30 13 * * 1-5"
    },
    {
      "path": "/api/cron/breadth",
      "schedule": "0 15 * * 1-5"
    },
    {
      "path": "/api/cron/breadth",
      "schedule": "30 16 * * 1-5"
    },
    {
      "path": "/api/cron/market-observations?task=send&tranche=1",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/market-observations?task=send&tranche=2",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/market-observations?task=evening",
      "schedule": "30 15 * * 1-5"
    }
  ]
}
