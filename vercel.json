{
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && next build",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/admin/studio/generate/route.ts": { "maxDuration": 60 },
    "src/app/api/admin/observations/generate/route.ts": { "maxDuration": 60 },
    "src/app/api/cron/market-observations/route.ts": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron/fii-dii-log",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/trial-drip",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/eod-update",
      "schedule": "0 13 * * 1-5"
    },
    {
      "path": "/api/cron/market-observations",
      "schedule": "30 0 * * *"
    }
  ]
}
